{
  "name": "pdd-georgia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "typecheck": "tsc -p packages/domain --noEmit && tsc -p packages/course --noEmit",
